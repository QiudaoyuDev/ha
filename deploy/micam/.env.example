# 仅复制为 .env 并在本机填写；不要提交真实值。
TZ=Asia/Shanghai
MILOCO_PORT=8000
MILOCO_LOG_LEVEL=warning
MILOCO_BASE_URL=https://127.0.0.1:8000
MILOCO_HOST_IP=127.0.0.1
MILOCO_PASSWORD=
CAMERA_ID=
# micam1 在 bridge 网络中，使用宿主机别名访问 host-network 的 go2rtc。
RTSP_URL=rtsp://host.docker.internal:8554/yuedu_living_camera
VIDEO_CODEC=hevc
STREAM_CHANNEL=0
