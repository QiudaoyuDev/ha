# 复制为 .env 后再启动 micam1；不要提交 .env。
TZ=Asia/Shanghai
MILOCO_PORT=8000
MILOCO_LOG_LEVEL=warning

# 在 https://localhost:8000 中设置 Miloco 密码后，填写该密码的小写 MD5 值。
MILOCO_PASSWORD=

# 在 Miloco 中绑定小米账号、找到“chuangmi.camera.069a01”后填写设备 DID。
CAMERA_ID=

# go2rtc 配置文件中的流名称保持一致。
RTSP_URL=rtsp://127.0.0.1:8554/yuedu_living_camera
VIDEO_CODEC=hevc
STREAM_CHANNEL=0
